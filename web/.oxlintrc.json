{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "import"],
  "categories": { "correctness": "error" },
  "rules": {
    "eslint/complexity": ["error", { "max": 10 }],
    "eslint/max-params": ["error", { "max": 4 }],
    "eslint/max-depth": ["error", { "max": 3 }],
    "eslint/max-lines-per-function": ["error", { "max": 40, "skipBlankLines": true, "skipComments": true }],
    "eslint/no-nested-ternary": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": { "eslint/max-lines-per-function": "off" }
    }
  ],
  "ignorePatterns":["dist/**", "node_modules/**"]
}
