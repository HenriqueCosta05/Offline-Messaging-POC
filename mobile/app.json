{
  "expo": {
    "name": "Offline Protocol PoC",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "offlineprotocolpoc",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "dev.hqcosta.offlineprotocolpoc",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Para achar quem está perto e conversar sem internet.",
        "NSMicrophoneUsageDescription": "Para chamadas e mensagens de voz.",
        "NSContactsUsageDescription": "Para mostrar quais contatos já usam o app."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2f2235",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.hqcosta.offlineprotocolpoc",
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.NEARBY_WIFI_DEVICES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2f2235",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "Para chamadas e mensagens de voz."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Para mostrar quais contatos já usam o app."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
